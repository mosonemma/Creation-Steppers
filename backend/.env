# Local environment for backend (keep this file private)
# Copy values into .env.example instead of committing to VCS in production

# Stripe (leave empty until you add your test key)
STRIPE_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# MTN / Airtel sandbox / production settings (fill API keys as needed)
