PORT=4000
# Add provider keys here:
# Stripe (server secret):
# STRIPE_SECRET=sk_test_...
# Optional redirect URLs for Checkout
# STRIPE_SUCCESS_URL=http://localhost:5500/donate.html?success=1
# STRIPE_CANCEL_URL=http://localhost:5500/donate.html?canceled=1

# MTN / Airtel placeholders (you will need real credentials for production):
# MTN (MOMO) example values — get these from MTN MOMO developer portal
# MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key
# MTN_API_USER=your-mtn-api-user
# MTN_API_KEY=your-mtn-api-key-or-primary-key

# Merchant receiving MSISDN (the number that receives payments in your account)
# MTN_PAYEE_NUMBER=25677xxxxxxx

# Airtel Money example values — get these from Airtel developer portal
# AIRTEL_BASE_URL=https://openapi.airtel.africa
# AIRTEL_CLIENT_ID=your-airtel-client-id
# AIRTEL_CLIENT_SECRET=your-airtel-client-secret
# AIRTEL_PRIMARY_KEY=your-airtel-primary-key

# Merchant receiving MSISDN for Airtel (e.g. 25670xxxxxxx)
# AIRTEL_PAYEE_NUMBER=25670xxxxxxx
